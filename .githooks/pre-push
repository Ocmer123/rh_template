#!/bin/sh
# Check the branch being pushed from as well as the refs being pushed to.
"$(dirname "$0")/guard-branch" || exit 1
# shellcheck disable=SC2034 # git passes four fields per line; only remote_ref is used
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main|refs/heads/dev)
      echo "Blocked: never push directly to '${remote_ref#refs/heads/}'. Open a pull request."
      exit 1;;
  esac
done
exit 0
